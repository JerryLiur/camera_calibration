<RCC>
  <qresource prefix="/app">
    <file alias="icon.png">spike-calibration.png</file>
    <file alias="icon.ico">spike-calibration.ico</file>
  </qresource>
  <qresource prefix="/ui">
    <file alias="chevron-down.svg">ui/chevron-down.svg</file>
    <file alias="check.svg">ui/check.svg</file>
    <file alias="chevron-down.png">ui/chevron-down.png</file>
    <file alias="chevron-down@2x.png">ui/chevron-down@2x.png</file>
    <file alias="check.png">ui/check.png</file>
    <file alias="check@2x.png">ui/check@2x.png</file>
  </qresource>
</RCC>
